---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="hero">
				<h1>Mona Mayhem</h1>
				<p>GitHub Contribution Battle Arena</p>
			</header>

			<section class="battle-panel" aria-labelledby="battle-title">
				<h2 id="battle-title">Choose Your Players</h2>

				<div class="player-grid">
					<label class="player-field" for="player-one">
						<span>Player 1</span>
						<input id="player-one" name="player-one" type="text" autocomplete="off" placeholder="octocat" />
					</label>

					<label class="player-field" for="player-two">
						<span>Player 2</span>
						<input id="player-two" name="player-two" type="text" autocomplete="off" placeholder="torvalds" />
					</label>
				</div>

				<button id="battle-button" class="battle-button" type="button">Battle</button>
				<p id="status-message" class="status-message" aria-live="polite">
					Enter two GitHub usernames to start a battle.
				</p>
			</section>

			<section id="results" class="results" aria-label="Battle results"></section>
		</main>

		<script>
			const playerOneInput = document.getElementById('player-one');
			const playerTwoInput = document.getElementById('player-two');
			const battleButton = document.getElementById('battle-button');
			const statusMessage = document.getElementById('status-message');
			const results = document.getElementById('results');

			const setStatus = (message, type = 'info') => {
				statusMessage.textContent = message;
				statusMessage.dataset.type = type;
			};

			const formatDateRange = (player) => {
				if (!player.from || !player.to) {
					return 'Date range unavailable';
				}

				return `${player.from} to ${player.to}`;
			};

			const renderPlayerCard = (label, username, data) => {
				const total = data.total_contributions ?? 'Unknown';
				const dateRange = formatDateRange(data);

				return `
					<article class="result-card">
						<p class="player-label">${label}</p>
						<h3>${username}</h3>
						<p class="contribution-total">${total}</p>
						<p class="result-meta">Total contributions</p>
						<p class="result-range">${dateRange}</p>
					</article>
				`;
			};

			const fetchContributions = async (username) => {
				const response = await fetch(`/api/contributions/${encodeURIComponent(username)}`);
				const data = await response.json();

				if (!response.ok) {
					throw new Error(data.error || 'Could not fetch contribution data');
				}

				return data;
			};

			const runBattle = async () => {
				const playerOne = playerOneInput.value.trim();
				const playerTwo = playerTwoInput.value.trim();

				results.innerHTML = '';

				if (!playerOne || !playerTwo) {
					setStatus('Please enter both GitHub usernames before battling.', 'error');
					return;
				}

				battleButton.disabled = true;
				setStatus('Loading contribution data...', 'loading');

				try {
					const [playerOneData, playerTwoData] = await Promise.all([
						fetchContributions(playerOne),
						fetchContributions(playerTwo),
					]);

					results.innerHTML = `
						${renderPlayerCard('Player 1', playerOne, playerOneData)}
						<div class="versus">VS</div>
						${renderPlayerCard('Player 2', playerTwo, playerTwoData)}
					`;
					setStatus('Battle results loaded.', 'success');
				} catch (error) {
					setStatus(error.message, 'error');
				} finally {
					battleButton.disabled = false;
				}
			};

			battleButton.addEventListener('click', runBattle);

			[playerOneInput, playerTwoInput].forEach((input) => {
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') {
						runBattle();
					}
				});
			});
		</script>

		<style>
			:root {
				color: #f7f7fb;
				background: #111827;
				font-family:
					Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background: #111827;
			}

			button,
			input {
				font: inherit;
			}

			.page-shell {
				width: min(960px, calc(100% - 32px));
				margin: 0 auto;
				padding: 56px 0;
			}

			.hero {
				margin-bottom: 32px;
				text-align: center;
			}

			.hero h1 {
				margin: 0;
				font-size: clamp(2.25rem, 7vw, 4rem);
				line-height: 1;
			}

			.hero p {
				margin: 12px 0 0;
				color: #c7d2fe;
				font-size: 1.1rem;
			}

			.battle-panel {
				padding: 24px;
				border: 1px solid #374151;
				border-radius: 8px;
				background: #1f2937;
			}

			.battle-panel h2 {
				margin: 0 0 20px;
				font-size: 1.25rem;
			}

			.player-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 16px;
			}

			.player-field {
				display: grid;
				gap: 8px;
			}

			.player-field span {
				color: #d1d5db;
				font-weight: 700;
			}

			.player-field input {
				width: 100%;
				padding: 12px 14px;
				border: 1px solid #4b5563;
				border-radius: 6px;
				color: #f9fafb;
				background: #111827;
			}

			.player-field input:focus {
				border-color: #22c55e;
				outline: 3px solid rgb(34 197 94 / 25%);
			}

			.battle-button {
				width: 100%;
				margin-top: 20px;
				padding: 12px 18px;
				border: 0;
				border-radius: 6px;
				color: #04130a;
				background: #22c55e;
				font-weight: 800;
				cursor: pointer;
			}

			.battle-button:hover {
				background: #4ade80;
			}

			.battle-button:disabled {
				cursor: wait;
				opacity: 0.7;
			}

			.status-message {
				min-height: 24px;
				margin: 16px 0 0;
				color: #d1d5db;
			}

			.status-message[data-type="error"] {
				color: #fca5a5;
			}

			.status-message[data-type="success"] {
				color: #86efac;
			}

			.results {
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: stretch;
				gap: 16px;
				margin-top: 24px;
			}

			.result-card {
				padding: 20px;
				border: 1px solid #374151;
				border-radius: 8px;
				background: #172033;
			}

			.player-label,
			.result-meta,
			.result-range {
				margin: 0;
				color: #9ca3af;
			}

			.result-card h3 {
				margin: 8px 0 16px;
				overflow-wrap: anywhere;
				font-size: 1.5rem;
			}

			.contribution-total {
				margin: 0;
				color: #86efac;
				font-size: 2rem;
				font-weight: 800;
			}

			.result-range {
				margin-top: 12px;
			}

			.versus {
				display: grid;
				place-items: center;
				min-width: 56px;
				color: #c7d2fe;
				font-weight: 900;
			}

			@media (max-width: 720px) {
				.page-shell {
					padding: 32px 0;
				}

				.player-grid,
				.results {
					grid-template-columns: 1fr;
				}

				.versus {
					min-height: 40px;
				}
			}
		</style>
	</body>
</html>
